# -----------------------------------------------------------------------------
# Hostinger application runtime
# Add these in Hostinger hPanel during the Node.js application deployment.
# Hostinger's GitHub integration does not require Hostinger credentials here.
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://your-domain.example
DEFAULT_TENANT_SLUG=acmi-construction

# Generate a long random value for production. Server only.
APP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Supabase / PostgreSQL
# Use the publishable key in browser code. Keep service-role and database values
# server-only. The app remains in demo mode while these are blank.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# Pooled connection for the deployed application. Copy the URI from Supabase.
DATABASE_URL=

# Direct connection for migrations and administrative tooling only.
DIRECT_URL=

# Optional deployment automation secrets. These are not needed for Hostinger
# hPanel's normal GitHub integration; use only for a future VPS workflow.
HOSTINGER_API_TOKEN=
HOSTINGER_VM_ID=

# -----------------------------------------------------------------------------
# Microsoft 365 placeholders — do not add real values until OAuth is implemented
# -----------------------------------------------------------------------------
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SHAREPOINT_SITE_ID=

# -----------------------------------------------------------------------------
# Email / webhooks / AI placeholders
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_API_KEY=
WEBHOOK_SIGNING_SECRET=
POWER_AUTOMATE_WEBHOOK_URL=
OPENAI_API_KEY=
